<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 메달 아이콘 배치 (1, 2, 3등만 표시) - 더 크게 -->
        <ImageView
            android:id="@+id/imageRank"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_medal_gold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- 순위 표시 - 메달 아이콘 위에 겹치게 배치 -->
        <TextView
            android:id="@+id/textRank"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="1"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/imageRank"
            app:layout_constraintTop_toTopOf="@id/imageRank"
            app:layout_constraintBottom_toBottomOf="@id/imageRank"
            app:layout_constraintEnd_toEndOf="@id/imageRank"/>

        <!-- 유저 이름 - 요청하신 대로 텍스트 스타일 적용 -->
        <TextView
            android:id="@+id/textUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="사용자명"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:fontFamily="@font/jeongi_anjunche"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/imageRank"
            app:layout_constraintEnd_toStartOf="@id/textRecycleCount"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- 재활용 횟수 -->
        <TextView
            android:id="@+id/textRecycleCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="247회"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/main_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>